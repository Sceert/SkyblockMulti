tellraw @s [{"text":"[Extremo] ","color":"dark_red","bold":true,"click_event":{"action":"run_command","command":"trigger sb_difficulty set 1"},"hover_event":{"action":"show_text","value":{"text":"Isla sin cofre inicial."}}},{"translate":"skyblockmulti.difficulty.extreme.desc","color":"gray"}]
execute if score #bonus_tier sb3_cfg matches 1.. run tellraw @s [{"text":"[Difícil] ","color":"red","bold":true,"click_event":{"action":"run_command","command":"trigger sb_difficulty set 2"},"hover_event":{"action":"show_text","value":{"text":"Cofre inicial básico."}}},{"translate":"skyblockmulti.difficulty.hard.desc","color":"gray"}]
execute if score #bonus_tier sb3_cfg matches 2.. run tellraw @s [{"text":"[Estándar] ","color":"gold","bold":true,"click_event":{"action":"run_command","command":"trigger sb_difficulty set 3"},"hover_event":{"action":"show_text","value":{"text":"Cofre inicial estándar."}}},{"translate":"skyblockmulti.difficulty.standard.desc","color":"gray"}]
execute if score #bonus_tier sb3_cfg matches 3.. run tellraw @s [{"text":"[Fácil] ","color":"green","bold":true,"click_event":{"action":"run_command","command":"trigger sb_difficulty set 4"},"hover_event":{"action":"show_text","value":{"text":"Cofre inicial para principiantes."}}},{"translate":"skyblockmulti.difficulty.easy.desc","color":"gray"}]
